# Project Information
PROJECT_NAME=LinkClassify
VERSION=0.1.0
DESCRIPTION=Link classification API

# API Configuration
API_V1_STR=/api/v1

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=linkclassify
POSTGRES_PORT=5432
# Or use a full connection string:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# Scraping API Configuration
SCRAPING_API_KEY=your_scraping_api_key_here
SCRAPING_API_URL=https://api.scraping.com/v1
SCRAPING_API_TIMEOUT=30

# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_API_URL=
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Security
SECRET_KEY=your-secret-key-here-minimum-32-characters-long-for-security
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
